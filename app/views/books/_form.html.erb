<% if book.errors.any? %>
  <div class="error-box">
    <ul>
      <% book.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: book do |f| %>
  <div>
    <%= f.label :title, "タイトル" %><br>
    <%= f.text_field :title %>
  </div>
  <div>
    <%= f.label :author, "著者" %><br>
    <%= f.text_field :author %>
  </div>
  <div>
    <%= f.label :price, "価格" %><br>
    <%= f.number_field :price %>
  </div>
  <div>
    <%= f.label :memo, "メモ" %><br>
    <%= f.text_area :memo %>
  </div>
  <%= f.submit %>
<% end %>
